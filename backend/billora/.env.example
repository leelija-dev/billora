# ============================================================================
# APP BASIC CONFIGURATION
# ============================================================================
APP_NAME=Billora
APP_ENV=local                                                    # local / production
APP_KEY=
APP_DEBUG=true                                                   # true for local, false for production

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ============================================================================
# LOGGING
# ============================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================================================
# DATABASE - Update with your credentials
# ============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_username
DB_PASSWORD=your_password

# ============================================================================
# SESSION CONFIGURATION
# ============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

# >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
# >>> LOCAL DEVELOPMENT (Uncomment these for local testing)              >>>
# >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
# SESSION_DOMAIN=localhost
# SESSION_SECURE_COOKIE=false
# SESSION_HTTP_ONLY=true
# SESSION_SAME_SITE=lax

# >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
# >>> PRODUCTION (Uncomment these for production server)                 >>>
# >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
SESSION_DOMAIN=.thefastbill.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ============================================================================
# BROADCASTING & QUEUE
# ============================================================================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ============================================================================
# CACHE
# ============================================================================
CACHE_STORE=database

# ============================================================================
# REDIS (Optional)
# ============================================================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================================================
# MAIL CONFIGURATION
# ============================================================================
MAIL_MAILER=log                                                 # Use 'log' for local, 'smtp' for production
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ENCRYPTION=tls

# ============================================================================
# AWS S3 (Optional)
# ============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================================================
# APP SPECIFIC
# ============================================================================
VITE_APP_NAME="${APP_NAME}"
APP_CURRENCY=₹

# Admin Contact
ADMIN_MAIL=admin@example.com
ADMIN_MOBILE=+919876543210
REMIND_DAYS_BEFORE=7

# ============================================================================
# CASHFREE PAYMENT (Optional)
# ============================================================================
CASHFREE_TEST_MODE=true
CASHFREE_TEST_APP_ID=
CASHFREE_TEST_SECRET_KEY=

# ============================================================================
# GOOGLE SOCIAL LOGIN (Optional)
# ============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_IMAGE_FOLDER_ID=
GOOGLE_QR_FOLDER_ID=
GOOGLE_BAR_CODE_FOLDER_ID=

# ============================================================================
# CROSS-DOMAIN AUTHENTICATION - URLs
# ============================================================================

# >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
# >>> LOCAL DEVELOPMENT (Uncomment these for localhost testing)          >>>
# >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
# APP_URL=http://localhost:8000
# FRONTEND_URL=http://localhost:4000
# REACT_APP_URL=http://localhost:3000
# FRONTEND_LOGIN_URL=http://localhost:4000

# >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
# >>> PRODUCTION (Uncomment these for live server)                       >>>
# >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
APP_URL=https://api.thefastbill.com
FRONTEND_URL=https://thefastbill.com
REACT_APP_URL=https://app.thefastbill.com

# ============================================================================
# CROSS-DOMAIN AUTHENTICATION - Cookie & Sanctum
# ============================================================================

# >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
# >>> LOCAL DEVELOPMENT (Uncomment these for localhost testing)          >>>
# >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
# SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:4000
# AUTH_COOKIE_DOMAIN=localhost
# AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_SAMESITE=lax

# >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
# >>> PRODUCTION (Uncomment these for live server)                       >>>
# >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
SANCTUM_STATEFUL_DOMAINS=thefastbill.com,app.thefastbill.com
AUTH_COOKIE_DOMAIN=.thefastbill.com
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
META_APP_ID=
META_APP_SECRET=
META_CALLBACK_URL=
META_CONFIG_ID=